          "pluginVersion": "4.21.3",
          "queryType": "table",
          "rawSql": "SELECT algorithm, countIf(is_anomaly) AS Anomalies\nFROM evaluations FINAL\nWHERE machine_id = ${machine_id:singlequote}\n  AND metric_name = ${metric_name:singlequote}\n  AND $__timeFilter(timestamp)\nGROUP BY algorithm\nORDER BY algorithm",
