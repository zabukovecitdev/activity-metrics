          "pluginVersion": "4.21.3",
          "queryType": "table",
          "rawSql": "SELECT m.timestamp AS Time, e.metric_name AS Metric, e.algorithm AS Algorithm, m.value AS Value\nFROM\n(\n    SELECT metric_id, metric_name, algorithm\n    FROM evaluations FINAL\n    WHERE machine_id = ${machine_id:singlequote}\n      AND is_anomaly\n      AND $__timeFilter(timestamp)\n) AS e\nINNER JOIN\n(\n    SELECT metric_id, timestamp, value\n    FROM metrics FINAL\n    WHERE machine_id = ${machine_id:singlequote}\n      AND $__timeFilter(timestamp)\n) AS m USING (metric_id)\nORDER BY Time DESC\nLIMIT 200",
          "refId": "A"
        }
      ]
    }
