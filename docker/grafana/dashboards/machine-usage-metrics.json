        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.21.3",
          "queryType": "table",
          "rawSql": "SELECT argMax(value, timestamp) AS Latest,\n       min(value) AS Min,\n       avg(value) AS Mean,\n       quantile(0.95)(value) AS P95,\n       max(value) AS Max,\n       count() AS Samples,\n       (toUnixTimestamp64Milli(max(timestamp)) - toUnixTimestamp64Milli(min(timestamp))) / 1000\n           / nullIf(count() - 1, 0) AS `Avg interval`\nFROM metrics FINAL\nWHERE machine_id = ${machine_id:singlequote}\n  AND name = ${metric_name:singlequote}\n  AND $__timeFilter(timestamp)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "id": 3,
