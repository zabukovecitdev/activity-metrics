          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.21.3",
          "queryType": "timeseries",
          "rawSql": "SELECT timestamp AS time, value AS `value`\nFROM metrics FINAL\nWHERE machine_id = ${machine_id:singlequote}\n  AND name = ${metric_name:singlequote}\n  AND $__timeFilter(timestamp)\nORDER BY time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.21.3",
          "queryType": "timeseries",
          "rawSql": "SELECT m.timestamp AS time, e.algorithm AS algorithm, m.value AS anomaly\nFROM\n(\n    SELECT metric_id, algorithm\n    FROM evaluations FINAL\n    WHERE machine_id = ${machine_id:singlequote}\n      AND metric_name = ${metric_name:singlequote}\n      AND is_anomaly\n      AND $__timeFilter(timestamp)\n) AS e\nINNER JOIN\n(\n    SELECT metric_id, timestamp, value\n    FROM metrics FINAL\n    WHERE machine_id = ${machine_id:singlequote}\n      AND name = ${metric_name:singlequote}\n      AND $__timeFilter(timestamp)\n) AS m USING (metric_id)\nORDER BY time",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
