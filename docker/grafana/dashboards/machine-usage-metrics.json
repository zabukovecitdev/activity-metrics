          "pluginVersion": "4.21.3",
          "queryType": "table",
          "rawSql": "SELECT\n    timestamp AS Time,\n    metric_name AS Metric,\n    algorithm AS Algorithm,\n    value AS Value,\n    round(score, 2) AS Score,\n    threshold AS Threshold,\n    multiIf(direction > 0, 'up', direction < 0, 'down', '') AS Direction\nFROM evaluations FINAL\nWHERE machine_id = ${machine_id:singlequote}\n  AND is_anomaly\n  AND $__timeFilter(timestamp)\nORDER BY timestamp DESC\nLIMIT 200",
          "refId": "A"
        }
