      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "pluginVersion": "4.21.3",
          "queryType": "table",
          "rawSql": "SELECT m.machine_id AS Machine, m.name AS Metric, m.unit AS Unit, m.samples AS Samples, m.last AS `Last sample`,\n       m.latest AS Latest, m.mean AS Mean, m.max AS Max,\n       a.anomalies AS Anomalies, a.flagged_by AS `Flagged by`\nFROM\n(\n    SELECT machine_id, name, any(unit) AS unit, count() AS samples, max(timestamp) AS last,\n           argMax(value, timestamp) AS latest, avg(value) AS mean, max(value) AS max\n    FROM metrics FINAL\n    WHERE $__timeFilter(timestamp)\n    GROUP BY machine_id, name\n) AS m\nLEFT JOIN\n(\n    SELECT machine_id, metric_name AS name, countIf(is_anomaly) AS anomalies,\n           arrayStringConcat(arraySort(groupUniqArrayIf(algorithm, is_anomaly)), ', ') AS flagged_by\n    FROM evaluations FINAL\n    WHERE $__timeFilter(timestamp)\n    GROUP BY machine_id, name\n) AS a USING (machine_id, name)\nORDER BY Anomalies DESC, Machine, Metric\nLIMIT 500",
          "refId": "A"
        }
      ]
