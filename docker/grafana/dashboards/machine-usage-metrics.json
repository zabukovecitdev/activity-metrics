          },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.21.3",
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(inserted_at) AS time,\n       quantile(0.5)(delay) AS p50,\n       quantile(0.95)(delay) AS p95\nFROM\n(\n    SELECT inserted_at,\n           (toUnixTimestamp64Milli(inserted_at) - toUnixTimestamp64Milli(timestamp)) / 1000 AS delay\n    FROM metrics\n    WHERE $__timeFilter(inserted_at)\n)\nWHERE delay < 3600\nGROUP BY time\nORDER BY time",
