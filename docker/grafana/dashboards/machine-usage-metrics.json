          "pluginVersion": "4.21.3",
          "queryType": "timeseries",
          "rawSql": "SELECT\n       m.value AS value,\n       m.timestamp AS time,\n       if(\n           m.metric_id IN (\n               SELECT metric_id\n               FROM anomalies\n               WHERE machine_id = ${machine_id:singlequote}\n                 AND metric_name = 'system.cpu.utilization'\n           ),\n           m.value,\n           NULL\n       ) AS anomaly\nFROM metrics AS m\nWHERE m.machine_id = ${machine_id:singlequote}\n  AND m.name = 'system.cpu.utilization'\n  AND $__timeFilter(m.timestamp)\nORDER BY time ASC;",
          "refId": "A"
        }
