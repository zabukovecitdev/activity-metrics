          "pluginVersion": "4.21.3",
          "queryType": "timeseries",
          "rawSql": "SELECT\n    m.timestamp AS time,\n    m.value AS value,\n    e.baseline AS baseline,\n    e.lower AS lower,\n    e.upper AS upper,\n    if(e.is_anomaly, m.value, NULL) AS anomaly\nFROM\n(\n    SELECT metric_id, timestamp, value\n    FROM metrics FINAL\n    WHERE machine_id = ${machine_id:singlequote}\n      AND name = 'system.cpu.utilization'\n      AND $__timeFilter(timestamp)\n) AS m\nLEFT JOIN\n(\n    SELECT metric_id, baseline, lower, upper, is_anomaly\n    FROM evaluations FINAL\n    WHERE machine_id = ${machine_id:singlequote}\n      AND metric_name = 'system.cpu.utilization'\n      AND algorithm = ${algorithm:singlequote}\n      AND $__timeFilter(timestamp)\n) AS e USING (metric_id)\nORDER BY time\n-- Without it, samples with no evaluation (warm-up, unscored) get 0 bands instead of gaps.\nSETTINGS join_use_nulls = 1",
          "refId": "A"
        }
      ],
      "title": "CPU usage \u00b7 ${algorithm}",
      "type": "timeseries"
