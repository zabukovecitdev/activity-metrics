          "queryType": "table",
          "rawSql": "SELECT (SELECT count() FROM metrics) AS `Metric rows`,\n       (SELECT count() FROM evaluations) AS `Evaluation rows`,\n       (SELECT uniqExact(machine_id, name) FROM metrics) AS Series,\n       (SELECT count() FROM system.parts WHERE active AND database = 'metrics' AND table = 'metrics') AS `Parts in metrics`,\n       (SELECT count() FROM system.parts WHERE active AND database = 'metrics' AND table = 'evaluations') AS `Parts in evaluations`",
          "refId": "A"
